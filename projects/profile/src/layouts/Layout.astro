---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Perinfoan — Tech Exploration & University Circle Hub',
  description = 'Wadah eksplorasi, eksperimen perangkat lunak, dan proyek seru mahasiswa circle Perinfoan di bawah domain perinfoan.web.id.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://perinfoan.web.id" />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#090a0f] text-[#f3f4f6] font-['Schibsted_Grotesk',system-ui,sans-serif] antialiased">
    <!--
THESIS: Perinfoan rejects the generic dark SaaS card template and corporate agency landing page; it owns a student zine & live-terminal hybrid where high-contrast modernist typography meets live telemetry and student camaraderie.
OWN-WORLD: Ground #090a0f deep slate, phosphor cyan #00f0ff and emerald #10b981 telemetry accents, crisp 1px borders (#1c2333), tabular stats, zero-gradient solid typography, custom cyan selection and monospace data tags.
STORY: Visitors discover an authentic university tech circle, inspect active subdomain experiments, and explore member cards built collaboratively via Git pull requests.
FIRST VIEWPORT: Asymmetric hero with bold group title, live telemetry status pill ('SYSTEM: NOMINAL // ALL SUBDOMAINS REACHABLE'), quick stats strip, and direct jump to the live showcase.
FORM: Student Zine / Indie Tech Pamphlet & Terminal Hybrid, index 6 on ordered list, seed key dc7c4486.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->

    <header class="sticky top-0 z-50 border-b border-[#1c2333] bg-[#090a0f]/90 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded bg-[#101422] border border-[#2e3852] flex items-center justify-center text-[#00f0ff] font-['JetBrains_Mono',monospace] font-bold text-sm group-hover:border-[#00f0ff] transition-colors">
            P_
          </div>
          <span class="font-bold text-lg tracking-tight text-white group-hover:text-[#00f0ff] transition-colors">
            perinfoan<span class="text-[#00f0ff]">.web.id</span>
          </span>
        </a>

        <nav class="flex items-center gap-1 sm:gap-6 text-sm font-medium text-[#9ca3af]">
          <a href="#showcase" class="px-3 py-1.5 hover:text-white transition-colors">Showcase</a>
          <a href="#members" class="px-3 py-1.5 hover:text-white transition-colors">Anggota</a>
          <a href="#about" class="px-3 py-1.5 hover:text-white transition-colors">Tentang</a>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded border border-[#2e3852] bg-[#101422] text-xs font-['JetBrains_Mono',monospace] text-[#00f0ff] hover:bg-[#161c30] hover:border-[#00f0ff] transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>GitHub PR</span>
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t border-[#1c2333] bg-[#06070a] py-12 text-sm text-[#9ca3af]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
          <span class="font-bold text-white tracking-tight">perinfoan.web.id</span>
          <span class="hidden sm:inline text-[#2e3852]">•</span>
          <span>Docker + Cloudflare Zero Trust Ingress</span>
        </div>

        <div class="flex items-center gap-6 font-['JetBrains_Mono',monospace] text-xs">
          <span class="inline-flex items-center gap-1.5 text-[#10b981]">
            <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
            STATUS: ONLINE
          </span>
          <span class="text-[#6b7280]">© {new Date().getFullYear()} Perinfoan Circle</span>
        </div>
      </div>
    </footer>
  </body>
</html>
