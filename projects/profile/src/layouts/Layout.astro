---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Perinfoan — Bersama Berkarya, Aku Perinfoan, Bersiaplah.',
  description = 'Wadah berkumpul, bermain, dan bereksperimen perangkat lunak circle Perinfoan.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400;1,6..72,600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization script (anti-FOUC) -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || storedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', storedTheme);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-paper)] text-[var(--ink-black)] font-['Epilogue',sans-serif] antialiased selection:bg-[var(--selection-bg)] selection:text-[var(--selection-text)]">
    <!--
THESIS: Perinfoan rejects generic dark SaaS cards, glowing AI neon templates, and fake telemetry dashboards. It is an authentic zine & physical collector's catalog: warm newsprint paper, bold editorial headlines with italic serif accents, collectible trading cards for the members, real project showcases with browser window frames, and genuine camaraderie. Supports high-craft light/dark themes.
OWN-WORLD: Ground #f7f4ec (dark #121110), card paper #ffffff (dark #1b1a18), secondary ground #ede8d8 (dark #24221f), dark ink #181715 (dark #f5f1e8), editorial vermilion accent #c93b1d (dark #e04d2d).
STORY: Visitors discover an authentic circle. They read the circle's founding manifesto, browse the member cards (complete with roles, avatars, quotes, and GitHub links), explore live/in-dev projects (Web Profile & UNO Multiplayer), see the weekly status/changelog, and learn how to contribute via Git PR.
FIRST VIEWPORT: Masthead 'PERINFOAN // JURNAL 01' with edition date, punchy headline 'Bersama Berkarya, Aku Perinfoan, Bersiaplah', stamped manifesto box, weekly status strip, and direct jump to the trading cards.
FORM: Indie Studio Zine & Collector Trading Cards, seed key dc7c4486.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->

    <!-- TOP MASTHEAD TICKER -->
    <div class="border-b-2 border-[var(--border-ink)] bg-[#181715] text-[#f7f4ec] px-4 py-1.5 text-xs font-['JetBrains_Mono',monospace] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--vermilion)]"></span>
        <span class="tracking-wide">PERINFOAN CIRCLE // KOLEKTIF EKSPLORASI TEKNOLOGI</span>
      </div>
    </div>

    <!-- MAIN EDITORIAL HEADER -->
    <header class="sticky top-0 z-50 border-b-2 border-[var(--border-ink)] bg-[var(--bg-paper)]/95 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
        <a href="/" class="flex items-center gap-1.5 sm:gap-2 group shrink-0">
          <span class="font-black text-xl sm:text-3xl tracking-tighter text-[var(--ink-black)] uppercase group-hover:text-[var(--vermilion)] transition-colors">
            PERINFOAN
          </span>
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--vermilion)] group-hover:scale-125 transition-transform"></span>
        </a>

        <nav class="flex items-center gap-1 sm:gap-5 text-xs sm:text-sm font-bold text-[var(--ink-black)]">
          <a href="#members" class="px-1.5 sm:px-3 py-1 hover:text-[var(--vermilion)] transition-colors">Anggota</a>
          <a href="#projects" class="px-1.5 sm:px-3 py-1 hover:text-[var(--vermilion)] transition-colors">Proyek</a>
          <a href="#about" class="px-1.5 sm:px-3 py-1 hover:text-[var(--vermilion)] transition-colors">Manifesto</a>

          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle Mode Gelap/Terang"
            class="btn-sm-physical p-2 min-w-[36px] min-h-[36px] sm:min-w-[40px] sm:min-h-[40px] flex items-center justify-center rounded-lg border-2 border-[var(--border-ink)] bg-[var(--bg-card)] text-[var(--ink-black)] cursor-pointer"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="theme-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="theme-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <a
            href="https://github.com/kevinkresna25/perinfoan"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-sm-physical hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded border-2 border-[var(--border-ink)] bg-[var(--bg-card-muted)] text-xs font-['JetBrains_Mono',monospace] text-[var(--ink-black)]"
          >
            <span>GitHub PR</span>
            <span class="text-[var(--vermilion)]">&rarr;</span>
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <!-- EDITORIAL COLOPHON FOOTER -->
    <footer class="border-t-2 border-[var(--border-ink)] bg-[var(--bg-card-muted)] py-14 text-sm text-[var(--ink-muted)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-10 border-b border-[var(--border-subtle)]">
          <div>
            <span class="font-black text-xl text-[var(--ink-black)] tracking-tight uppercase">PERINFOAN</span>
            <p class="font-['Newsreader',serif] italic text-sm text-[var(--ink-muted)] mt-2 leading-relaxed">
              Jurnal eksperimen dan rumah digital kolektif Perinfoan. Menolak wacana di grup chat, merayakan karya nyata.
            </p>
          </div>

          <div>
            <span class="font-bold text-xs uppercase tracking-wider text-[var(--ink-black)] font-['JetBrains_Mono',monospace]">
              RUANG EKSPLORASI
            </span>
            <p class="text-xs text-[var(--ink-muted)] mt-2 leading-relaxed font-['JetBrains_Mono',monospace]">
              Wadah kreasi independen untuk merealisasikan berbagai ide game, aplikasi web, dan eksperimen digital bersama.
            </p>
          </div>

          <div class="flex flex-col md:items-end justify-between">
            <span class="font-bold text-xs uppercase tracking-wider text-[var(--ink-black)] font-['JetBrains_Mono',monospace]">
              STATUS SISTEM
            </span>
            <div class="flex items-center gap-2 mt-2 text-xs font-['JetBrains_Mono',monospace] text-[var(--ink-black)]">
              <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
              <span>SISTEM NOMINAL // ONLINE</span>
            </div>
          </div>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-['JetBrains_Mono',monospace] text-[var(--ink-subtle)]">
          <span>© {new Date().getFullYear()} Lingkaran Perinfoan. Diterbitkan secara bebas.</span>
          <span>DIBANGUN DENGAN ASTRO & SECAWAN KOPI SUSU</span>
        </div>
      </div>
    </footer>

    <!-- Theme Toggle Interactive Handler -->
    <script is:inline>
      const toggleBtn = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('theme-sun');
      const moonIcon = document.getElementById('theme-moon');

      function syncToggleIcons(theme) {
        if (theme === 'dark') {
          sunIcon.classList.remove('hidden');
          moonIcon.classList.add('hidden');
        } else {
          sunIcon.classList.add('hidden');
          moonIcon.classList.remove('hidden');
        }
      }

      const initialTheme = document.documentElement.getAttribute('data-theme') || 'light';
      syncToggleIcons(initialTheme);

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nextTheme);
          localStorage.setItem('theme', nextTheme);
          syncToggleIcons(nextTheme);
        });
      }
    </script>
  </body>
</html>
