---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const members = await getCollection('members');
const sortedMembers = members.sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Perinfoan — Bersama Berkarya, Aku Perinfoan, Bersiaplah."
  description="Wadah berkumpul, bermain, dan bereksperimen perangkat lunak circle Perinfoan."
>
  <main>
    <!-- HERO SECTION: ZINE EDITORIAL -->
    <section class="border-b-2 border-[var(--border-ink)] bg-[var(--bg-paper)] pt-12 pb-16 md:pt-20 md:pb-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <!-- STATUS BAR -->
        <div class="status-tape-physical mb-8 inline-flex flex-wrap items-center gap-3 px-4 py-2 rounded-lg border-2 border-[var(--gold-tape-border)] bg-[var(--gold-tape-bg)] text-xs font-['JetBrains_Mono',monospace]">
          <span class="font-bold text-[var(--gold-tape-text)]">📌 STATUS MINGGU INI:</span>
          <span class="text-[var(--gold-tape-text)] font-medium">Lagi ngulik proyek bareng, push rank santai, & oprek game UNO</span>
          <span class="hidden sm:inline text-[var(--gold-tape-subtle)]">•</span>
          <span class="hidden sm:inline font-bold text-[var(--gold-tape-text)]">SEMANGAT NGOPREK & MABAR</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <!-- Main Editorial Lead -->
          <div class="lg:col-span-8">
            <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-[var(--ink-black)] tracking-tight leading-[1.04]">
              Bersama Berkarya, <em class="font-['Newsreader',serif] font-normal italic text-[var(--vermilion)]">Aku Perinfoan</em>, Bersiaplah.
            </h1>

            <p class="mt-5 sm:mt-6 text-base sm:text-xl text-[var(--ink-muted)] font-medium leading-relaxed max-w-2xl">
              Tempat berkumpul, berdiskusi, main game santai di waktu senggang, dan membangun beragam proyek mandiri. Dibangun dengan rasa penasaran, secawan kopi, dan canda tawa tongkrongan.
            </p>

            <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
              <a
                href="#members"
                class="btn-physical px-6 py-3.5 rounded-lg border-2 border-[var(--border-ink)] bg-[var(--vermilion)] text-white font-bold text-sm tracking-wide text-center"
              >
                Buka Profil Anggota &darr;
              </a>
              <a
                href="#projects"
                class="btn-physical px-6 py-3.5 rounded-lg border-2 border-[var(--border-ink)] bg-[var(--bg-card)] text-[var(--ink-black)] font-bold text-sm tracking-wide text-center"
              >
                Lihat Koleksi Proyek
              </a>
            </div>
          </div>

          <!-- Stamped Manifesto Card -->
          <div class="manifesto-box-physical lg:col-span-4 p-6 sm:p-7 rounded-xl border-2 border-dashed border-[var(--border-ink)] bg-[var(--bg-card-muted)] rotate-1 hover:rotate-0 transition-transform">
            <span class="text-xs font-black font-['JetBrains_Mono',monospace] tracking-wider text-[var(--vermilion)] uppercase block">
              // MANIFESTO CIRCLE
            </span>
            <blockquote class="mt-3 font-['Newsreader',serif] italic text-lg sm:text-xl text-[var(--ink-black)] leading-snug">
              "Lebih baik mencoba bikin game seru walau banyak bug, daripada cuma jadi wacana di grup chat."
            </blockquote>
            <div class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-['JetBrains_Mono',monospace] text-[var(--ink-muted)]">
              <span>KOLEKTIF KAWAN</span>
              <span>PROYEK MANDIRI</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- MEMBERS SECTION: TRADING CARDS -->
    <section id="members" class="border-b-2 border-[var(--border-ink)] bg-[var(--bg-card-muted)] py-16 sm:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4 border-b-2 border-[var(--border-ink)] pb-6">
          <div>
            <span class="text-xs font-black font-['JetBrains_Mono',monospace] tracking-widest text-[var(--vermilion)] uppercase">
              ROSTER RESMI // 2026
            </span>
            <h2 class="text-3xl sm:text-5xl font-black text-[var(--ink-black)] tracking-tight mt-1">
              Profil Anggota Perinfoan
            </h2>
            <p class="text-[var(--ink-muted)] mt-2 font-medium">
              Kartu pengenal resmi dari setiap anggota Perinfoan. Data dikelola langsung oleh masing-masing anggota melalui Git.
            </p>
          </div>
          <div class="btn-sm-physical text-xs font-['JetBrains_Mono',monospace] font-bold text-[var(--ink-black)] bg-[var(--bg-paper)] px-3 py-1.5 rounded border-2 border-[var(--border-ink)] self-start md:self-end">
            ROSTER AKTIF
          </div>
        </div>

        <!-- TRADING CARDS GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {sortedMembers.map((member) => (
            <article class="card-physical flex flex-col justify-between rounded-xl border-2 border-[var(--border-card)] bg-[var(--bg-card)] p-5">
              <div>
                <!-- Top Card Slot & Badge -->
                <div class="flex items-center justify-between font-['JetBrains_Mono',monospace] text-xs border-b border-[var(--border-inner)] pb-3 mb-4">
                  <span class="font-bold text-[var(--vermilion)]">
                    #{String(member.data.order).padStart(2, '0')} // SLOT
                  </span>
                  {member.data.nickname && (
                    <span class="px-2 py-0.5 rounded bg-[var(--bg-card-muted)] text-[var(--ink-black)] font-semibold text-[11px] border border-[var(--border-subtle)]">
                      @{member.data.nickname}
                    </span>
                  )}
                </div>

                <!-- Avatar Image -->
                <div class="relative overflow-hidden rounded-lg border-2 border-[var(--border-card)] bg-[var(--bg-card-muted)] mb-4 aspect-[4/3] sm:aspect-square">
                  <img
                    src={member.data.avatar}
                    alt={member.data.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-[var(--badge-bg)] text-[var(--badge-text)] font-['JetBrains_Mono',monospace] text-[10px] font-bold shadow-[2px_2px_0px_var(--shadow-color)]">
                    AKU PERINFOAN
                  </div>
                </div>

                <!-- Name & Role -->
                <h3 class="text-xl font-black text-[var(--ink-black)] leading-tight">
                  {member.data.name}
                </h3>
                <p class="font-['Newsreader',serif] italic text-sm text-[var(--ink-muted)] font-semibold mt-1">
                  {member.data.role}
                </p>

                <!-- Bio Text -->
                {(member.data.bio || member.body?.trim()) && (
                  <p class="text-xs text-[var(--ink-muted)] leading-relaxed mt-2.5 font-medium">
                    {member.data.bio || member.body?.trim()}
                  </p>
                )}

                <!-- Quote Box -->
                {member.data.quote && (
                  <div class="mt-3 p-2.5 rounded-lg bg-[var(--bg-card-inner)] text-xs text-[var(--ink-black)] font-medium leading-relaxed font-['Newsreader',serif] italic border border-[var(--border-subtle)] flex items-start gap-1.5">
                    <span class="text-[var(--vermilion)] font-serif text-sm font-bold leading-none select-none">“</span>
                    <span class="flex-1">{member.data.quote}</span>
                    <span class="text-[var(--vermilion)] font-serif text-sm font-bold leading-none select-none">”</span>
                  </div>
                )}

                <!-- Skills / Tech Tags -->
                {member.data.skills.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-3.5">
                    {member.data.skills.map((skill) => (
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold font-['JetBrains_Mono',monospace] bg-[var(--bg-card-muted)] text-[var(--ink-muted)] border border-[var(--border-subtle)]">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Card Bottom: Socials -->
              <div class="mt-6 pt-3 border-t border-[var(--border-inner)] flex flex-wrap items-center justify-between gap-2 text-xs font-['JetBrains_Mono',monospace]">
                <div class="flex flex-wrap items-center gap-2.5">
                  {member.data.socials?.github && (
                    <a
                      href={member.data.socials.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--ink-black)] font-bold hover:text-[var(--vermilion)] transition-colors inline-flex items-center gap-0.5"
                    >
                      <span>GitHub</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                  {member.data.socials?.linkedin && (
                    <a
                      href={member.data.socials.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--ink-muted)] font-bold hover:text-[var(--vermilion)] transition-colors inline-flex items-center gap-0.5"
                    >
                      <span>LinkedIn</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                  {member.data.socials?.instagram && (
                    <a
                      href={member.data.socials.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--ink-muted)] font-bold hover:text-[var(--vermilion)] transition-colors inline-flex items-center gap-0.5"
                    >
                      <span>Instagram</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                  {member.data.socials?.website && (
                    <a
                      href={member.data.socials.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--ink-muted)] font-bold hover:text-[var(--vermilion)] transition-colors inline-flex items-center gap-0.5"
                    >
                      <span>Web</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                  {!member.data.socials?.github && !member.data.socials?.linkedin && !member.data.socials?.instagram && !member.data.socials?.website && (
                    <span class="text-[var(--ink-subtle)] text-[10px]">VERIFIED MEMBER</span>
                  )}
                </div>
                <span class="text-[var(--ink-subtle)] text-[10px] uppercase tracking-wider font-bold">VERIFIED</span>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- PROJECTS SECTION: GALLERY FRAME -->
    <section id="projects" class="border-b-2 border-[var(--border-ink)] bg-[var(--bg-paper)] py-16 sm:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4 border-b-2 border-[var(--border-ink)] pb-6">
          <div>
            <span class="text-xs font-black font-['JetBrains_Mono',monospace] tracking-widest text-[var(--vermilion)] uppercase">
              ETALASE PROYEK & KARYA
            </span>
            <h2 class="text-3xl sm:text-5xl font-black text-[var(--ink-black)] tracking-tight mt-1">
              Koleksi Proyek & Eksperimen
            </h2>
            <p class="text-[var(--ink-muted)] mt-2 font-medium">
              Kumpulan karya dan eksperimen digital yang dirancang untuk dinikmati bersama.
            </p>
          </div>
          <div class="text-xs font-['JetBrains_Mono',monospace] font-bold text-[var(--ink-muted)]">
            SHOWCASE COUNT: {sortedProjects.length}
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {sortedProjects.map((project) => (
            <article class="project-card-physical flex flex-col justify-between rounded-xl border-2 border-[var(--border-card)] bg-[var(--bg-card)] p-6 sm:p-8">
              <div>
                <!-- Category & Status Badge -->
                <div class="flex items-center justify-between gap-3 mb-4 font-['JetBrains_Mono',monospace] text-xs">
                  <span class="px-2.5 py-1 rounded bg-[var(--badge-bg)] text-[var(--badge-text)] font-bold shadow-[1px_1px_0px_var(--shadow-color)]">
                    {project.data.category}
                  </span>

                  {project.data.status === 'live' && (
                    <span class="inline-flex items-center gap-1.5 font-bold text-[#10b981]">
                      <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
                      STATUS: LIVE
                    </span>
                  )}
                  {project.data.status === 'in-development' && (
                    <span class="inline-flex items-center gap-1.5 font-bold text-[var(--vermilion)]">
                      <span class="w-2 h-2 rounded-full bg-[var(--vermilion)]"></span>
                      IN DEVELOPMENT
                    </span>
                  )}
                </div>

                <h3 class="text-2xl sm:text-3xl font-black text-[var(--ink-black)] leading-tight">
                  {project.data.title}
                </h3>

                <p class="text-[var(--ink-muted)] text-sm mt-3 leading-relaxed font-medium">
                  {project.data.description}
                </p>

                <!-- Project Preview Window Frame -->
                <div class="mt-6 rounded-lg border-2 border-[var(--border-card)] bg-[var(--bg-window)] p-4 text-white">
                  <div class="flex items-center justify-between pb-3 border-b border-[#333] text-xs font-['JetBrains_Mono',monospace] text-[#aaa]">
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-[#ef4444]"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#f59e0b]"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#10b981]"></span>
                      <span class="ml-2 text-white font-bold">{project.data.title}</span>
                    </div>
                    <span class="text-[10px] text-[#888]">LIVE APPLICATION</span>
                  </div>

                  <div class="py-6 text-center">
                    {project.data.category.toLowerCase().includes('game') ? (
                      <div>
                        <div class="text-4xl mb-2">🃏 🎮 🔴 🔵</div>
                        <p class="text-xs font-['JetBrains_Mono',monospace] text-[#ded8c4]">
                          Lobby: #RUANG-SANTUY • Realtime WebSocket
                        </p>
                      </div>
                    ) : (
                      <div>
                        <div class="text-4xl mb-2">🏛️ 📰 ✦ ⚡</div>
                        <p class="text-xs font-['JetBrains_Mono',monospace] text-[#ded8c4]">
                          Astro • Modern Editorial Platform
                        </p>
                      </div>
                    )}
                  </div>
                </div>

                <!-- Tech Stack Tags -->
                <div class="flex flex-wrap gap-2 mt-5">
                  {project.data.techStack.map((tech) => (
                    <span class="px-2.5 py-1 rounded text-xs font-bold font-['JetBrains_Mono',monospace] bg-[var(--bg-card-muted)] text-[var(--ink-black)] border border-[var(--border-subtle)]">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Footer info -->
              <div class="mt-8 pt-4 border-t border-[var(--border-inner)] flex items-center justify-between text-xs font-['JetBrains_Mono',monospace]">
                <span class="text-[var(--ink-muted)]">
                  Karya: <strong class="text-[var(--ink-black)]">{project.data.contributors.join(', ')}</strong>
                </span>

                {project.data.url ? (
                  <a
                    href={project.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-bold text-[var(--vermilion)] hover:underline inline-flex items-center gap-1"
                  >
                    <span>Kunjungi Proyek</span>
                    <span>&rarr;</span>
                  </a>
                ) : (
                  <span class="font-bold text-[var(--vermilion)]">
                    Segera Hadir
                  </span>
                )}
              </div>
            </article>
          ))}
        </div>

        <!-- NEW PROJECT IDEA BOX -->
        <div class="mt-10 p-6 sm:p-8 rounded-xl border-2 border-dashed border-[var(--border-ink)] bg-[var(--bg-card-muted)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <span class="px-2 py-0.5 rounded bg-[var(--badge-bg)] text-[var(--badge-text)] font-['JetBrains_Mono',monospace] text-xs font-bold">
              IDE BARU
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-[var(--ink-black)] mt-2">
              Punya ide game atau utilitas baru untuk dibuat?
            </h3>
            <p class="text-sm text-[var(--ink-muted)] mt-1 font-medium max-w-xl">
              Setiap anggota berhak membuat folder baru di <code class="font-['JetBrains_Mono',monospace] font-bold text-[var(--ink-black)]">projects/&lt;nama-project&gt;</code> dan men-deploy karya baru secara mandiri.
            </p>
          </div>

          <a
            href="#about"
            class="btn-physical px-5 py-3 rounded-lg border-2 border-[var(--border-ink)] bg-[var(--bg-card)] text-[var(--ink-black)] font-bold text-xs font-['JetBrains_Mono',monospace] whitespace-nowrap"
          >
            Pelajari Alur Git &rarr;
          </a>
        </div>

      </div>
    </section>

    <!-- MANIFESTO & GIT GUIDE SECTION -->
    <section id="about" class="bg-[var(--bg-card-muted)] py-16 sm:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

          <!-- Story / Colophon Column -->
          <div class="lg:col-span-6">
            <span class="text-xs font-black font-['JetBrains_Mono',monospace] tracking-widest text-[var(--vermilion)] uppercase">
              TENTANG PERINFOAN
            </span>
            <h2 class="text-3xl sm:text-4xl font-black text-[var(--ink-black)] tracking-tight mt-1">
              Dari Obrolan Santai Menjadi Rumah Digital
            </h2>

            <div class="mt-6 space-y-4 text-[var(--ink-muted)] font-medium leading-relaxed text-sm sm:text-base">
              <p>
                Perinfoan berawal dari grup obrolan santai. Di sela-sela rutinitas harian, anggota sering berdiskusi tentang hal-hal baru di dunia teknologi, bermain game bersama, dan merealisasikan berbagai ide aplikasi yang seru.
              </p>
              <p>
                Platform ini menjadi wadah bersama untuk berekspresi. Setiap anggota berhak membuat eksperimen, mencoba teknologi baru, dan men-deploy hasil karya secara terisolasi.
              </p>
              <p class="font-['Newsreader',serif] italic text-base text-[var(--ink-black)]">
                "Kami percaya bahwa cara terbaik untuk belajar adalah dengan membangun hal-hal nyata bersama kawan terdekat."
              </p>
            </div>
          </div>

          <!-- Git Contribution Manual Box -->
          <div class="guide-box-physical lg:col-span-6 p-6 sm:p-8 rounded-xl border-2 border-[var(--border-ink)] bg-[var(--bg-card)]">
            <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4 mb-6">
              <h3 class="text-lg sm:text-xl font-black text-[var(--ink-black)] tracking-tight">
                Panduan Memperbarui Kartu Profil
              </h3>
              <span class="text-xs font-['JetBrains_Mono',monospace] font-bold text-[var(--vermilion)]">
                KARTU PROFIL
              </span>
            </div>

            <p class="text-xs text-[var(--ink-muted)] font-medium mb-6">
              Web ini menggunakan data statis. Setiap anggota di lingkaran Perinfoan dapat memperbarui kartu profil masing-masing melalui GitHub Pull Request:
            </p>

            <ol class="space-y-4 text-xs font-['JetBrains_Mono',monospace]">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-md bg-[var(--vermilion)] text-white font-bold flex items-center justify-center shrink-0 mt-0.5 text-xs shadow-[1px_1px_0px_var(--shadow-color)]">
                  1
                </span>
                <div>
                  <span class="font-bold text-[var(--ink-black)] text-sm">Clone & Buat Branch</span>
                  <p class="text-[var(--ink-muted)] font-['Epilogue',sans-serif] mt-0.5 text-xs">
                    Clone repositori ke perangkat lokal dan buat branch baru: <code class="px-1.5 py-0.5 rounded bg-[var(--bg-card-inner)] border border-[var(--border-subtle)] text-[var(--vermilion)] font-bold">git checkout -b profile/nama-anggota</code>.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-md bg-[var(--vermilion)] text-white font-bold flex items-center justify-center shrink-0 mt-0.5 text-xs shadow-[1px_1px_0px_var(--shadow-color)]">
                  2
                </span>
                <div>
                  <span class="font-bold text-[var(--ink-black)] text-sm">Edit File Profil</span>
                  <p class="text-[var(--ink-muted)] font-['Epilogue',sans-serif] mt-0.5 text-xs">
                    Buka <code class="px-1.5 py-0.5 rounded bg-[var(--bg-card-inner)] border border-[var(--border-subtle)] text-[var(--vermilion)] font-bold">projects/profile/src/content/members/</code>, perbarui nama, kutipan, dan keahlian pada file slot yang dipilih.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-md bg-[var(--vermilion)] text-white font-bold flex items-center justify-center shrink-0 mt-0.5 text-xs shadow-[1px_1px_0px_var(--shadow-color)]">
                  3
                </span>
                <div>
                  <span class="font-bold text-[var(--ink-black)] text-sm">Kirim Pull Request</span>
                  <p class="text-[var(--ink-muted)] font-['Epilogue',sans-serif] mt-0.5 text-xs">
                    Push branch ke repositori dan <a href="https://github.com/kevinkresna25/perinfoan/pulls" target="_blank" rel="noopener noreferrer" class="text-[var(--vermilion)] font-bold underline hover:no-underline">buka Pull Request di GitHub &rarr;</a>. Setelah disetujui dan digabungkan, profil akan otomatis terpasang di halaman utama.
                  </p>
                </div>
              </li>
            </ol>
          </div>

        </div>

      </div>
    </section>
  </main>
</Layout>
